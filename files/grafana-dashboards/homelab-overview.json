      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "VM",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (pve_up{id=~\"qemu/.*\"} * on (id) group_left (name) pve_guest_info{template=\"0\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (100 * pve_cpu_usage_ratio * on (id) group_left (name) pve_guest_info{template=\"0\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (100 * (pve_memory_usage_bytes / pve_memory_size_bytes) * on (id) group_left (name) pve_guest_info{template=\"0\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (label_replace(100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\", instance!=\"pr3\"} / node_filesystem_size_bytes{mountpoint=\"/\", instance!=\"pr3\"}), \"name\", \"$1\", \"instance\", \"(.*)\"))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
