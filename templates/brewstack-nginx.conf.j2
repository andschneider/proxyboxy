# Managed by Ansible (brewstack.yml).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root {{ brewstack_frontend_dir }}/dist;
    index index.html;

    location /api {
        proxy_pass http://127.0.0.1:{{ brewstack_api_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Roast uploads (Artisan files) go through here as multipart.
        client_max_body_size 20m;
    }

    location /ws {
        proxy_pass http://127.0.0.1:{{ brewstack_ws_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # Keep idle shot streams open.
        proxy_read_timeout 1h;
    }

    # SPA: unknown paths fall back to the app's router.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
