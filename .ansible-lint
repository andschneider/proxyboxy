---
# CI lints the current playbooks at the repo root.
exclude_paths:
  - terraform/
  - secrets/
  # Prometheus rules and Grafana dashboards, not Ansible.
  - files/
  # Encrypted, and CI has no vault password.
  - host_vars/*/vault.yml

skip_list:
  # Commands here are guarded by a `when` (or an explicit check task) and
  # always change something when they do run.
  - no-changed-when
  # `when: x is changed` is used for steps that must run right away, in
  # order, not at the end of the play like handlers.
  - no-handler
