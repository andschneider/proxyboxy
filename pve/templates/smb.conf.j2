# Managed by Ansible (pve/files.yml).
[global]
   server role = standalone server
   server string = files
   hosts allow = 127.0.0.1 {{ share_smb_networks | join(' ') }}
   hosts deny = ALL
   server min protocol = SMB3
   map to guest = never
   disable netbios = yes
   smb ports = 445
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   log file = /var/log/samba/log.%m
   max log size = 1000
   logging = file

   # Finder metadata (tags, resource forks) as xattrs instead of ._ files.
   vfs objects = fruit streams_xattr
   fruit:metadata = stream
   fruit:model = MacSamba
   fruit:nfs_aces = no
   fruit:veto_appledouble = no
   fruit:wipe_intentionally_left_blank_rfork = yes
   fruit:delete_empty_adfiles = yes

[share]
   path = {{ share_path }}
   valid users = {{ share_user }}
   read only = no
   force user = {{ share_user }}
   force group = {{ share_user }}
   create mask = 0664
   directory mask = 2775
